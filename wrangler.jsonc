// Cloudflare Workers: serves the built app from dist, and sends every unknown path to
// index.html so links such as /menu work when opened directly.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cookedbyugo-admin",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
